# Production/Supabase connection. Keep the real value in .env only.
DATABASE_URL=postgresql://username:password@host:6543/postgres?sslmode=require
COOKIE_SECURE=false

# Required only when the admins table is empty. Use at least 12 characters.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-one-time-password
ADMIN_INITIAL_NAME=Quan tri vien

# Optional email notification.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_TO=

# Optional cross-origin frontend domains, separated by commas.
ALLOWED_ORIGINS=
